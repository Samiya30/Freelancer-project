generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// EXISTING ENUMS
// ============================================================

enum LeadStatus {
  New
  Contacted
  Qualified
  Proposal
  Won
  Lost
}

enum ClientStatus {
  Active
  Inactive
}

enum ProposalStatus {
  Draft
  Sent
  Viewed
  Accepted
  Rejected
  Expired
}

enum ContractStatus {
  Draft
  Sent
  Viewed
  Signed
  Expired
  Cancelled
}

enum ProjectStatus {
  Planning
  InProgress
  Review
  Completed
  OnHold
}

enum TaskStatus {
  ToDo
  InProgress
  Review
  Done
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

enum InvoiceStatus {
  Draft
  Sent
  Viewed
  Paid
  Overdue
  Cancelled
}

enum PaymentStatus {
  Completed
  Pending
  Failed
}

enum PaymentMethod {
  UPI
  BankTransfer
  Card
  Cash
}

enum ExpenseCategory {
  Software
  Marketing
  Travel
  Office
  Equipment
  Utilities
  Other
}

enum ExpenseStatus {
  Paid
  Pending
}

// ============================================================
// RBAC ENUMS
// ============================================================

enum WorkspaceMemberStatus {
  Active
  Suspended
  Invited
}

enum PermissionEffect {
  Allow
  Deny
}

enum AuditAction {
  Created
  Updated
  Deleted
  Granted
  Revoked
  Promoted
  Demoted
  Invited
  Removed
  Suspended
  Restored
  RoleCreated
  RoleUpdated
  RoleDeleted
}

// ============================================================
// USER
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   @default("")
  firstName String   @default("")
  lastName  String   @default("")
  phone     String   @default("")
  role      String   @default("Freelancer")
  bio       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients       Client[]
  leads         Lead[]
  proposals     Proposal[]
  contracts     Contract[]
  projects      Project[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  conversations Conversation[]
  messages      Message[]
  files         File[]
  settings      Settings?
  sessions      Session[]

  // RBAC / Workspace
  ownedWorkspaces     Workspace[]        @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  createdRoles        Role[]             @relation("RoleCreator")
  permissionOverrides MemberPermission[]
  auditLogs           AuditLog[]         @relation("AuditActor")
}

// ============================================================
// WORKSPACE
// ============================================================

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId Int
  owner   User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members     WorkspaceMember[]
  roles       Role[]
  permissions Permission[]
  auditLogs   AuditLog[]

  @@index([ownerId])
}

// ============================================================
// WORKSPACE MEMBER
// ============================================================

model WorkspaceMember {
  id          Int                   @id @default(autoincrement())
  workspaceId Int
  userId      Int
  roleId      Int
  status      WorkspaceMemberStatus @default(Active)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  permissionOverrides MemberPermission[]
  auditLogs           AuditLog[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([roleId])
  @@index([workspaceId, status])
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById Int?
  createdBy   User? @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members         WorkspaceMember[]
  rolePermissions RolePermission[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdById])
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id          Int      @id @default(autoincrement())
  key         String
  name        String
  description String   @default("")
  category    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]
  memberOverrides MemberPermission[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([category])
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================

model RolePermission {
  id           Int              @id @default(autoincrement())
  roleId       Int
  permissionId Int
  effect       PermissionEffect @default(Allow)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ============================================================
// MEMBER-SPECIFIC PERMISSION OVERRIDES
// ============================================================

model MemberPermission {
  id           Int              @id @default(autoincrement())
  memberId     Int
  permissionId Int
  effect       PermissionEffect
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  member     WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User            @relation(fields: [grantedById], references: [id], onDelete: Restrict)

  grantedById Int

  @@unique([memberId, permissionId])
  @@index([memberId])
  @@index([permissionId])
  @@index([grantedById])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  entityType  String
  entityId    String?
  description String      @default("")
  metadata    Json?
  createdAt   DateTime    @default(now())

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  memberId Int?
  member   WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@index([memberId])
  @@index([entityType, entityId])
}

// ============================================================
// SESSION
// ============================================================

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CLIENT
// ============================================================

model Client {
  id           Int          @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  company      String
  status       ClientStatus @default(Active)
  projects     Int          @default(0)
  totalRevenue Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leads          Lead[]
  proposals      Proposal[]
  contracts      Contract[]
  projectRecords Project[]
  invoices       Invoice[]
  payments       Payment[]
}

// ============================================================
// LEAD
// ============================================================

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  email     String
  company   String
  phone     String?
  source    String
  value     Float      @default(0)
  status    LeadStatus @default(New)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

// ============================================================
// PROPOSAL
// ============================================================

model Proposal {
  id          Int            @id @default(autoincrement())
  number      String
  title       String
  client      String
  clientEmail String
  project     String
  amount      Float
  status      ProposalStatus @default(Draft)
  issueDate   DateTime
  validUntil  DateTime
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId     Int?
  clientRecord Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

// ============================================================
// CONTRACT
// ============================================================

model Contract {
  id          Int            @id @default(autoincrement())
  number      String
  title       String
  client      String
  clientEmail String
  project     String
  value       Float
  status      ContractStatus @default(Draft)
  startDate   DateTime
  endDate     DateTime
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId     Int?
  clientRecord Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  client      String
  clientEmail String
  description String
  status      ProjectStatus @default(Planning)
  startDate   DateTime
  dueDate     DateTime
  budget      Float
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId     Int?
  clientRecord Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tasks       Task[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  payments    Payment[]
  expenses    Expense[]
}

// ============================================================
// TASK
// ============================================================

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  projectId   Int
  projectName String
  status      TaskStatus   @default(ToDo)
  priority    TaskPriority @default(Medium)
  dueDate     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// TIME ENTRY
// ============================================================

model TimeEntry {
  id          Int      @id @default(autoincrement())
  description String
  projectId   Int
  projectName String
  taskId      Int?
  taskName    String?
  date        DateTime
  duration    Int
  billable    Boolean  @default(true)
  hourlyRate  Float    @default(0)
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  client      String
  clientEmail String
  project     String
  amount      Float
  status      InvoiceStatus @default(Draft)
  issueDate   DateTime
  dueDate     DateTime
  description String
  tax         Float         @default(0)
  discount    Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId     Int?
  clientRecord Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId     Int?
  projectRecord Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments Payment[]
}

// ============================================================
// INVOICE ITEM
// ============================================================

model InvoiceItem {
  id          Int    @id @default(autoincrement())
  description String
  quantity    Float
  rate        Float

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id            Int           @id @default(autoincrement())
  paymentNumber String        @unique
  clientName    String
  invoiceNumber String
  projectName   String
  amount        Float
  date          DateTime
  method        PaymentMethod
  status        PaymentStatus
  createdAt     DateTime      @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId     Int?
  clientRecord Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  projectId     Int?
  projectRecord Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ============================================================
// EXPENSE
// ============================================================

model Expense {
  id          Int             @id @default(autoincrement())
  title       String
  description String
  category    ExpenseCategory
  amount      Float
  date        DateTime
  status      ExpenseStatus
  project     String?
  vendor      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId     Int?
  projectRecord Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ============================================================
// CONVERSATION
// ============================================================

model Conversation {
  id          Int      @id @default(autoincrement())
  name        String
  company     String
  initials    String
  gradient    String
  online      Boolean  @default(false)
  unread      Int      @default(0)
  starred     Boolean  @default(false)
  lastMessage String
  lastTime    DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MESSAGE
// ============================================================

model Message {
  id     Int      @id @default(autoincrement())
  text   String
  sender String
  time   DateTime @default(now())
  read   Boolean  @default(false)

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// FILE
// ============================================================

model File {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  size        Int
  storagePath String
  folder      String
  shared      Boolean  @default(false)
  client      String?
  project     String?
  clientId    Int?
  projectId   Int?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([folder])
}

// ============================================================
// SETTINGS
// ============================================================

model Settings {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceName String @default("")
  website       String @default("")
  industry      String @default("Technology")
  timezone      String @default("Asia/Kolkata")
  currency      String @default("INR (₹)")

  notificationEmail     Boolean @default(true)
  notificationProjects  Boolean @default(true)
  notificationInvoices  Boolean @default(true)
  notificationTasks     Boolean @default(true)
  notificationWeekly    Boolean @default(true)
  notificationMarketing Boolean @default(false)

  appearance String @default("system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
